# این فایل را به .env کپی کنید و مقادیر واقعی را فقط در .env بنویسید (.env در گیت نمی‌رود).
NEXTCAM_ENV=development
NEXTCAM_LOG_LEVEL=INFO

# SQL Server محلی. نام سرور/instance و رمز را با سیستم خودتان جایگزین کنید.
# کاراکترهای خاص رمز باید URL-encode شوند (مثلاً @ ← %40 ، # ← %23).
# برای named instance: در SQL Server Configuration Manager پورت TCP ثابت تنظیم کنید و localhost:<پورت> بنویسید.
# اتصال با کاربر SQL (پیشنهادی: کاربر اختصاصی، نه sa):
NEXTCAM_DATABASE_URL=mssql+pyodbc://nextcam_app:CHANGE_ME@localhost:1433/nextcam?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# یا با Windows Authentication:
# NEXTCAM_DATABASE_URL=mssql+pyodbc://@localhost/nextcam?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes

# یک مقدار تصادفی طولانی:  python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXTCAM_SECRET_KEY=CHANGE_ME

# فقط در محیط توسعه/آزمون. در production رد می‌شود.
NEXTCAM_ENABLE_MOCK_PAYMENT_TERMINAL=false

# کارت‌خوان سامان، پی‌سی‌پوز مرکزی (ADR-0024). مقادیر را سامان می‌دهد.
# NEXTCAM_SEP_PCPOS_URL=https://...
# NEXTCAM_SEP_PCPOS_IDENTITY_URL=https://...
# NEXTCAM_SEP_PCPOS_CLIENT_ID=
# NEXTCAM_SEP_PCPOS_CLIENT_SECRET=
# NEXTCAM_SEP_PCPOS_USERNAME=
# NEXTCAM_SEP_PCPOS_PASSWORD=
# NEXTCAM_SEP_PCPOS_ALLOW_HTTP=false

# سامانه باسکول و پلاک‌خوان → حسابداری (ADR-0025). هر دو خالی = گیرنده‌ی وب‌هوک خاموش.
# رمز = «کلید امضای وب‌هوک» که آن سامانه هنگام ساخت وب‌هوک یک بار نشان می‌دهد.
# NEXTCAM_VA_WEBHOOK_SECRET=
# NEXTCAM_VA_TENANT_ID=
# کد شعبه‌ی اسناد آن (خالی = بدون شعبه):
# NEXTCAM_VA_BRANCH_CODE=

# برای اجرای تست‌های دیتابیسی: یک دیتابیس جدا و دورریختنی (هرگز دیتابیس عملیاتی)
# TEST_DATABASE_URL=mssql+pyodbc://nextcam_app:CHANGE_ME@localhost:1433/nextcam_test?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
